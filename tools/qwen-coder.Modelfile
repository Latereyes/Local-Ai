# Qwen3.8 27B Uncensored (orcarouter, IQ3_M, ~14 GB) come modello per il codice.
# Lo crea tools/installa-qwen-coder.ps1:  ollama create qwen3.8-coder -f qwen-coder.Modelfile
# IQ3_M e non Q3_K_L (~15 GB): con 16 GB di VRAM il Q3_K_L lascerebbe troppo poco spazio al contesto.
FROM orcarouter/Qwen3.8-27B-Uncensored:iq3_m

# Tutti i layer in GPU (RTX 4070 Ti Super 16 GB): niente offload sulla CPU
PARAMETER num_gpu 999
# 48k di contesto: rimisurato il 22/10/2026 (Ollama 0.40.8, flash attention, KV cache q8_0) a contesto pieno,
# VRAM dedicata totale del PC (desktop compreso, ~0,5 GB): 40k 14,8 GB, 48k 15,1 GB, 56k 15,4 GB, 64k 15,65 GB.
# Il tetto utile e' ~15,65 GB: oltre, il driver riversa nella RAM condivisa (80k +0,75 GB, 96k +1,3 GB) e rallenta.
# Con num_gpu 999 "ollama ps" dice comunque 100% GPU: il riversamento si vede solo dai contatori Windows
# \GPU Adapter Memory(*)\Shared Usage. A 48k restano ~0,55 GB di margine per desktop e altre app.
# (questo modello ha pochi strati di attenzione piena: ogni 8k di contesto costa solo ~300 MB).
# LocalAI legge questo valore e lo usa al posto di OLLAMA_CTX per questo modello.
# Se la RAM condivisa sale mentre il modello lavora, torna a 40960 e ricrea il modello.
PARAMETER num_ctx 49152

# Campionamento consigliato da Qwen per il codice
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
