# Qwen3.8 27B (Unsloth, UD-Q3_K_XL, ~13 GB) come modello per il codice.
# Lo crea tools/installa-qwen-coder.ps1:  ollama create qwen3.8-coder -f qwen-coder.Modelfile
FROM hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q3_K_XL

# Tutti i layer in GPU (RTX 4070 Ti Super 16 GB): niente offload sulla CPU
PARAMETER num_gpu 999
# 16k di contesto: con la KV cache in q8_0 sta nei 16 GB insieme ai pesi.
# LocalAI legge questo valore e lo usa al posto di OLLAMA_CTX per questo modello.
# Se "ollama ps" mostra una parte su CPU, scendi a 12288 o 8192 e ricrea il modello.
PARAMETER num_ctx 16384

# Campionamento consigliato da Qwen per il codice
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
