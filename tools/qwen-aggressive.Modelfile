# Qwen3.8 27B Uncensored Aggressive di HauhauCS (Q3_K_P, ~13,4 GB), secondo Qwen accanto a Qwen Coder.
# Lo crea tools/installa-qwen-aggressive.ps1:  ollama create qwen3.8-aggressive -f qwen-aggressive.Modelfile
# Il GGUF si scarica a mano (lo fa lo script): Ollama non accetta il tag Q3_K_P da Hugging Face,
# perché K_P è una quantizzazione personalizzata. Senza il file mmproj, quindi senza visione.
FROM ./Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q3_K_P.gguf

# Tutti i layer in GPU e 16k di contesto: misurato 14,9 GB su 16,4, 100% in GPU
PARAMETER num_gpu 999
PARAMETER num_ctx 16384

# Campionamento consigliato dalla scheda del modello (senza ragionamento)
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER presence_penalty 1.5
